# -----------------------------------------------------------------------------
# EgemOps ortam değişkenleri — bu dosyayı ".env.local" olarak kopyalayıp doldur.
# .env.local git'e GİRMEZ (gizli kalır). Buradaki .env.example ise şablondur.
# -----------------------------------------------------------------------------

# Supabase (Supabase panelinde: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SADECE SUNUCU — admin işlemleri (kullanıcı oluşturma) için. GİZLİ, asla NEXT_PUBLIC yapma.
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Storage — dosya/resim yükleme için (Auth aşamasında gerekmez).
# Firebase panelinde: Project settings > General > "Your apps" > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Satın Alma modülü — AI görsel çıkarımı (OpenAI). SADECE SUNUCU, gizli.
OPENAI_API_KEY=
# İsteğe bağlı; görsel destekli model. Varsayılan: gpt-4o-mini
OPENAI_VISION_MODEL=

# Satın Alma — tedarikçi adayı için web arama. Biri yeterli (önce TAVILY denenir).
# SADECE SUNUCU, gizli.
TAVILY_API_KEY=
SERPER_API_KEY=

# Satın Alma — Gmail OAuth (teklif e-postası gönderimi). SADECE SUNUCU, gizli.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/satinalma/gmail/callback
# Teklif e-postaları YALNIZCA bu alıcılara gönderilebilir (virgülle ayır).
SATINALMA_IZINLI_ALICILAR=
# Token şifreleme anahtarı (32 bayt hex). Üret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SATINALMA_TOKEN_SECRET=
